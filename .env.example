# Copy to .env for local runs. Never commit a real broker URL.

# Required. The exporter falls back to REDIS_URL when this is unset.
# In GKE this is injected from the care-backend-secret key of the same name.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Comma-separated logical queue names. CARE uses a single default queue.
CELERY_QUEUES=celery

# Kombu priority shards. Must start at 0 and stay within 0-9.
CELERY_REDIS_PRIORITY_STEPS=0,3,6,9

# Optional literal prefix applied to every Redis key. Empty unless Celery is
# configured with a global_keyprefix.
CELERY_REDIS_GLOBAL_KEYPREFIX=

# Broker timeouts, in seconds. Keep the socket timeout below the scrape timeout.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5

# How long a scrape waits for an in-flight collection before failing fast.
COLLECTION_LOCK_TIMEOUT_SECONDS=1

EXPORTER_HOST=0.0.0.0
EXPORTER_PORT=8000
LOG_LEVEL=INFO
